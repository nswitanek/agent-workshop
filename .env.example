# Participant identifier (used to namespace agents and eval runs)
PARTICIPANT_INITIALS="XX"

# Azure AI Foundry Project (Session 1: Foundry Agents)
PROJECT_ENDPOINT="https://<your-resource>.services.ai.azure.com/api/projects/<your-project>"
MODEL_DEPLOYMENT_NAME="gpt-5-mini"

# Azure OpenAI (Session 2: MAF Agents & Capstone)
AZURE_AI_PROJECT_ENDPOINT="https://<your-resource>.services.ai.azure.com/api/projects/<your-project>"
AZURE_OPENAI_RESPONSES_DEPLOYMENT_NAME="gpt-5-mini"
# Note: gpt-5-mini or gpt-5.2 recommended; gpt-4.1 has tool-calling issues

# Embedding model (used by memory stores and vector search)
AZURE_OPENAI_EMBEDDING_DEPLOYMENT_NAME="text-embedding-3-small"

# Evaluation (Exercise 07) — separate model for evaluator LLM-as-judge
# to avoid rate-limit contention with the agent model
EVAL_MODEL_DEPLOYMENT_NAME="gpt-4.1"

# Memory store chat model (Exercise 06) — must be deployed in Azure OpenAI connection
MEMORY_CHAT_MODEL="gpt-4o"

# FRED API key (free — register at https://fred.stlouisfed.org/docs/api/api_key.html)
# Used in Exercises 04 (OpenAPI tools) and 04 (function calling)
FRED_API_KEY="your-fred-api-key-here"

# FRED connection ID (optional — for OpenAPI tool auth via Foundry connection)
# FRED_CONNECTION_ID=""
